<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MainForge.Core\MainForge.Core.csproj" />
    <ProjectReference Include="..\MainForge.ClaudeCode\MainForge.ClaudeCode.csproj" />
    <ProjectReference Include="..\MainForge.Tools\MainForge.Tools.csproj" />
    <ProjectReference Include="..\MainForge.Agents\MainForge.Agents.csproj" />
    <!-- O servidor MCP é um executável à parte, lançado pelo Claude Code. A referência existe
         só para o binário dele parar na mesma pasta de saída, onde ConfiguracaoDoServidorMcp
         o procura. -->
    <ProjectReference Include="..\MainForge.Mcp\MainForge.Mcp.csproj" />
  </ItemGroup>

  <!-- Os prompts dos agentes viajam com o binário publicado: sem eles o aplicativo baixado não
       tem o que mandar ao Claude Code. Continuam sendo os mesmos arquivos de Agents/ do
       repositório — a regra "prompt nunca embutido em C#" segue valendo, o que muda é só a cópia.

       Copiar na **publicação** e não no build é o que mantém o desenvolvimento funcionando: a
       raiz do projeto é descoberta pela presença de Agents/ com prompts, então um Agents/ dentro
       de bin/ faria o `dotnet run` tomar a pasta de saída como raiz e não enxergar os livros nem
       as bases do repositório. -->
  <ItemGroup>
    <Content Include="..\..\Agents\*.md" Link="Agents\%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TFM com sufixo -windows por causa do resolvedor de fontes do PdfSharp, que lê
         C:\Windows\Fonts para preencher a ficha. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MainForge.Cli</RootNamespace>
    <!-- Publicação: um executável só, com o runtime .NET dentro. É o que permite baixar o
         aplicativo e usá-lo sem instalar nada além do Claude Code. -->
    <RuntimeIdentifier Condition="'$(PublishSingleFile)' == 'true'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(PublishSingleFile)' == 'true'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
    <AssemblyTitle>MainForge</AssemblyTitle>
    <Product>MainForge</Product>
    <!-- O ícone do executável: uma bigorna sobre a brasa da forja, em pixel art. Ele é gerado por
         tools/gerar-icone.ps1, que é onde o desenho mora — o .ico aqui é o resultado, e não a
         fonte. Sem esta propriedade o Windows mostra o ícone genérico de console, que é o que
         quem baixa o aplicativo vê primeiro. -->
    <ApplicationIcon>mainforge.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
