<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MainForge.Core\MainForge.Core.csproj" />
    <ProjectReference Include="..\MainForge.Claude\MainForge.Claude.csproj" />
    <ProjectReference Include="..\MainForge.Tools\MainForge.Tools.csproj" />
    <ProjectReference Include="..\MainForge.Agents\MainForge.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.39.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TFM com sufixo -windows porque a DPAPI usada para guardar a API key só existe no
         Windows: assim o compilador sabe disso e não acusa CA1416 em cada chamada. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MainForge.Cli</RootNamespace>
  </PropertyGroup>

</Project>
