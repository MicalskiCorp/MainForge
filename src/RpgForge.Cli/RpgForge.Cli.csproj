<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RpgForge.Core\RpgForge.Core.csproj" />
    <ProjectReference Include="..\RpgForge.Claude\RpgForge.Claude.csproj" />
    <ProjectReference Include="..\RpgForge.Tools\RpgForge.Tools.csproj" />
    <ProjectReference Include="..\RpgForge.Agents\RpgForge.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.39.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TFM com sufixo -windows porque a DPAPI usada para guardar a API key só existe no
         Windows: assim o compilador sabe disso e não acusa CA1416 em cada chamada. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RpgForge.Cli</RootNamespace>
  </PropertyGroup>

</Project>
