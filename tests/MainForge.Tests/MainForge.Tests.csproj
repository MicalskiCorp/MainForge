<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- -windows por causa da DPAPI em ArmazenamentoDeChaveApi (e do resolvedor de fontes
         do PdfSharp, que lê C:\Windows\Fonts). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\FichaTeste.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\RegrasTeste.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MainForge.Core\MainForge.Core.csproj" />
    <ProjectReference Include="..\..\src\MainForge.Claude\MainForge.Claude.csproj" />
    <ProjectReference Include="..\..\src\MainForge.Tools\MainForge.Tools.csproj" />
    <ProjectReference Include="..\..\src\MainForge.Agents\MainForge.Agents.csproj" />
  </ItemGroup>

</Project>