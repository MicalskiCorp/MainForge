# Build outputs
[Bb]in/
[Oo]bj/
*.user

# Visual Studio
.vs/

# Rider / VS Code
.idea/
.vscode/

# User secrets / local config (never commit API keys)
appsettings.Local.json
*.secrets.json
.env

# Permissões do Claude Code de quem desenvolve: são da máquina, não do projeto.
.claude/settings.local.json

# Generated character sheets stay local by default.
/Output/Personagens/*
!/Output/Personagens/.gitkeep

# Livros e fichas importados pelo usuário ficam locais: são PDFs comerciais, pesam dezenas de
# MB e, uma vez no histórico do Git, só saem reescrevendo-o. O conhecimento destilado deles
# (Sistemas/) também fica local, pelo mesmo motivo — veja o bloco abaixo.
# SistemaTeste é a exceção: os PDFs dele são fixtures minúsculos do harness de validação.
/Input/*/
!/Input/SistemaTeste/
/Templates/*/
!/Templates/SistemaTeste/

# O texto extraído dos PDFs é derivado e regerável (e, vindo de um livro comercial, tem o mesmo
# problema de direitos que o PDF). A regra acima já o exclui nos sistemas do usuário; esta cobre
# o SistemaTeste, que é versionado.
/Input/**/_texto/

# As bases de conhecimento ficam locais. Elas são as regras dos livros importados reescritas em
# Markdown: quando o livro é comercial, o conteúdo continua sendo dele, e um repositório público
# não é lugar para isso. Cada pessoa gera a sua a partir dos livros que tem.
#
# A exceção é SistemaTeste: sistema fictício, escrito para o harness de validação, sem dono a
# quem prestar contas.
/Sistemas/*/
!/Sistemas/SistemaTeste/

# O índice da raiz de Sistemas/ é derivado e lista os sistemas que existem *nesta* máquina —
# ou seja, descreve os livros de quem está usando o aplicativo. Ele é regerado a cada gravação,
# então versioná-lo só serviria para vazar essa lista e sujar o diff a cada execução.
/Sistemas/index.md

# Pacote gerado por publicar.ps1.
/publicado/

# Atalho do Windows criado na máquina de quem desenvolve: guarda o caminho absoluto do
# executável, então só vale naquele computador e quebra a cada pasta renomeada.
*.lnk
